# Copy to backend/.env, matching the database credentials chosen in root .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=jlpt_db
# Alternative: DATABASE_URL=postgresql://user:password@127.0.0.1:5433/jlpt_db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Optional AI tutor: see docs/setup.md for provider selection and limits.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
