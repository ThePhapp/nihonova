# Copy to .env at repository root for Docker Compose. Do not commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=jlpt_db
POSTGRES_PORT=5433
# Required only by the application Compose overlay; generate securely before use.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ORIGIN=http://localhost:3000
